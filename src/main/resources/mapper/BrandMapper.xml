<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.brandpromo.mapper.BrandMapper">

    <select id="findAll" resultType="com.brandpromo.entity.Brand">
        SELECT * FROM brand ORDER BY created_at DESC
    </select>

    <select id="findById" resultType="com.brandpromo.entity.Brand">
        SELECT * FROM brand WHERE id = #{id}
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO brand (name, logo_url, description)
        VALUES (#{name}, #{logoUrl}, #{description})
    </insert>

    <update id="update">
        UPDATE brand
        <set>
            <if test="name != null">name = #{name},</if>
            <if test="logoUrl != null">logo_url = #{logoUrl},</if>
            <if test="description != null">description = #{description},</if>
        </set>
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM brand WHERE id = #{id}
    </delete>
</mapper>
