<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.brandpromo.mapper.ProductCategoryMapper">

    <select id="findAll" resultType="com.brandpromo.entity.ProductCategory">
        SELECT * FROM product_category ORDER BY sort_order, id
    </select>

    <select id="findById" resultType="com.brandpromo.entity.ProductCategory">
        SELECT * FROM product_category WHERE id = #{id}
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO product_category (name, parent_id, sort_order, icon, status)
        VALUES (#{name}, #{parentId}, #{sortOrder}, #{icon}, #{status})
    </insert>

    <update id="update">
        UPDATE product_category
        <set>
            <if test="name != null">name = #{name},</if>
            <if test="parentId != null">parent_id = #{parentId},</if>
            <if test="sortOrder != null">sort_order = #{sortOrder},</if>
            <if test="icon != null">icon = #{icon},</if>
            <if test="status != null">status = #{status},</if>
        </set>
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM product_category WHERE id = #{id}
    </delete>
</mapper>
